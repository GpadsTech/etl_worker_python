# Desenvolvimento local; não colocar credenciais reais neste arquivo.
# Para usar outro arquivo privado: ETL_ENV_FILE=.env.etl python -m app.main
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=moringa
POSTGRES_USER=etl_local
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_SCHEMA=etl_private

# Local sem TLS. No Supabase: verify-full e CA confiável do projeto.
# Se omitido: disable em localhost/127.0.0.1/::1; verify-full nos demais hosts.
POSTGRES_SSLMODE=disable
POSTGRES_SSLROOTCERT=
POSTGRES_CONNECT_TIMEOUT=10
# Milissegundos; 0 desativa o respectivo limite.
POSTGRES_STATEMENT_TIMEOUT_MS=60000
POSTGRES_LOCK_TIMEOUT_MS=5000

# Supabase: copiar host, porta, banco e usuário do painel.
# Usar conexão direta ou pooler SESSION; nunca TRANSACTION (trava de sessão).
# POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=/caminho/para/ca-supabase.crt

FIREBASE_DATABASE_URL=
FIREBASE_CREDENTIALS=/caminho/para/firebase-credentials.json
ETL_INTERVAL_SECONDS=60
ETL_PAGE_SIZE=500
ETL_LOOKBACK_RECORDS=1000
