# Copiar para .env.etl e preencher localmente; nunca versionar credenciais reais.
# Usar após provisionar o login etl_runtime e aplicar as migrações.
# Executar: ETL_ENV_FILE=.env.etl .venv/bin/python -m app.main
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=moringa
POSTGRES_USER=etl_runtime
POSTGRES_PASSWORD=PREENCHA_A_SENHA_DO_ETL_LOCAL
POSTGRES_SCHEMA=etl_private
POSTGRES_SSLMODE=disable
POSTGRES_SSLROOTCERT=
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_STATEMENT_TIMEOUT_MS=60000
POSTGRES_LOCK_TIMEOUT_MS=5000

FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS=/caminho/absoluto/para/firebase-credentials.json
ETL_INTERVAL_SECONDS=60
