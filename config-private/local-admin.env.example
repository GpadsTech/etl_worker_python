# Modelo administrativo local; copiar para local-admin.env e preencher.
# Não usar esse acesso na coleta diária nem versionar credenciais reais.
# Selecionar somente para manutenção:
# ETL_ENV_FILE=config-private/local-admin.env python -m app.reprocess_history correct --help
# Migrações via psql não leem este arquivo automaticamente.
# Ajustar usuário/senha conforme a inicialização do banco local.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=moringa
POSTGRES_USER=etl_local
POSTGRES_PASSWORD=PREENCHA_A_SENHA_ADMINISTRATIVA_LOCAL
POSTGRES_SCHEMA=etl_private
POSTGRES_SSLMODE=disable
POSTGRES_SSLROOTCERT=
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_STATEMENT_TIMEOUT_MS=60000
POSTGRES_LOCK_TIMEOUT_MS=5000

FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS=/caminho/absoluto/para/firebase-credentials.json
ETL_INTERVAL_SECONDS=60
ETL_PAGE_SIZE=500
ETL_LOOKBACK_RECORDS=1000
