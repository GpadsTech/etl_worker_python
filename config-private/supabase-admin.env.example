# Modelo administrativo do Supabase; copiar para supabase-admin.env e preencher.
# Não usar esse acesso na coleta diária nem versionar credenciais reais.
# Selecionar somente para manutenção:
# ETL_ENV_FILE=config-private/supabase-admin.env python -m app.reprocess_history correct --help
# Migrações via psql não leem este arquivo automaticamente.
# Usar conexão direta ou pooler SESSION, nunca TRANSACTION.
POSTGRES_HOST=aws-0-SUA-REGIAO.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.SEU_PROJECT_REF
POSTGRES_PASSWORD=PREENCHA_A_SENHA_ADMINISTRATIVA_DO_SUPABASE
POSTGRES_SCHEMA=etl_private
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/caminho/absoluto/para/ca-supabase.crt
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_STATEMENT_TIMEOUT_MS=60000
POSTGRES_LOCK_TIMEOUT_MS=5000

# Necessário nos comandos que consultam a origem, como correção histórica.
FIREBASE_DATABASE_URL=https://SEU-PROJETO-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS=/caminho/absoluto/para/firebase-credentials.json
ETL_INTERVAL_SECONDS=60
ETL_PAGE_SIZE=500
ETL_LOOKBACK_RECORDS=1000
