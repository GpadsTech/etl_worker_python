# Copiar para .env.supabase: credencial ADMINISTRATIVA, somente para migrações.
# Não usar esse perfil no worker. Copiar host e usuário da conexão Session pooler.
POSTGRES_HOST=aws-0-SUA-REGIAO.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.SEU_PROJECT_REF
POSTGRES_PASSWORD=PREENCHA_A_SENHA_ADMINISTRATIVA
POSTGRES_SCHEMA=etl_private
POSTGRES_SSLMODE=verify-full
# Baixar a CA do projeto em Database Settings > SSL Configuration.
POSTGRES_SSLROOTCERT=/caminho/absoluto/para/ca-supabase.crt
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_STATEMENT_TIMEOUT_MS=60000
POSTGRES_LOCK_TIMEOUT_MS=5000
